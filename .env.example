# Copy to .env and fill in. Nothing here is required: with no keys at all the
# app runs in offline demo mode (scripted agent + simulated PayPal checkout).

# --- PayPal (sandbox credentials from https://developer.paypal.com/dashboard/) ---
PAYPAL_MODE=sandbox            # sandbox | live | mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Claude (https://console.anthropic.com/) ---
LLM_PROVIDER=anthropic         # anthropic | fake
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=high          # low | medium | high | xhigh | max

# --- Product catalog ---
CATALOG=mock                   # mock | channel3
CHANNEL3_API_KEY=              # https://trychannel3.com (free tier: 1,000 searches/month)

# --- Server ---
PORT=8080
PUBLIC_URL=http://localhost:8080   # must be reachable by the browser; PayPal redirects here
DATA_FILE=data/mandate.json
STATIC_DIR=web/dist
CURRENCY=USD
