# Copy to .env and fill in. Nothing here is required: with no keys at all the
# app runs in offline demo mode (scripted agent + simulated PayPal checkout).

# --- PayPal (sandbox credentials from https://developer.paypal.com/dashboard/) ---
PAYPAL_MODE=sandbox            # sandbox | live | mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=             # optional: ID of a webhook pointing at <PUBLIC_URL>/paypal/webhook
PAYPAL_MCP=auto                # order assistant on PayPal's MCP server: auto | on | off
PAYPAL_MCP_URL=                # optional override of the MCP endpoint for the Anthropic connector

# --- Claude (https://console.anthropic.com/) ---
LLM_PROVIDER=anthropic         # anthropic | fake
# FAKE_AGENT_DELAY=700ms       # offline demo only: pause before each scripted tool call so the live mission view can be watched
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=high          # low | medium | high | xhigh | max
# Alternative: route through OpenRouter's Anthropic-compatible endpoint with an
# OpenRouter key (leave ANTHROPIC_API_KEY empty, use OpenRouter's model slug):
# ANTHROPIC_BASE_URL=https://openrouter.ai/api
# ANTHROPIC_AUTH_TOKEN=sk-or-...
# ANTHROPIC_MODEL=anthropic/claude-opus-5.5

# --- Product catalog ---
CATALOG=mock                   # mock | channel3
CHANNEL3_API_KEY=              # https://trychannel3.com (free tier: 1,000 searches/month)

# --- Server ---
PORT=8080
PUBLIC_URL=http://localhost:8080   # must be reachable by the browser; PayPal redirects here
DATA_FILE=data/mandate.json
STATIC_DIR=web/dist
CURRENCY=USD
MAX_MISSIONS_PER_HOUR=40           # protects the model budget on a public demo; 0 = unlimited
PER_CLIENT_LIMITS=1                # per-address limits (runs, searches, PayPal calls, mandates, event streams); 0 = off
DEMO_BUYER_HINT=                   # e.g. "sb-xxxx@personal.example.com / password" shown to testers
